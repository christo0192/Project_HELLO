# Production terraform.tfvars template — copy to terraform.tfvars and fill in real values
# WARNING: terraform.tfvars is gitignored. Never commit real OCIDs or credentials.
#
# PRODUCTION APPLY IS BLOCKED. To unblock:
#   1. Replace backend "local" in main.tf with a real encrypted remote backend.
#   2. Run: terraform init
#   3. Set production_apply_enabled = true below.

region                    = "placeholder-region"
tenancy_ocid              = "ocid1.tenancy.oc1..__CHANGE_ME__"
project_name              = "hr-screening"
cost_center               = "engineering"
alert_email               = "__CHANGE_ME__"
monthly_budget_amount      = 100   # conservative for OCI free-tier; owner must approve
production_apply_enabled   = false   # set to true after remote state is configured
