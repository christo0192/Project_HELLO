#!/usr/bin/env python3
"""OCI Region Benchmark CLI — deterministic, credential-free, synthetic-capable.

Usage:
    oci-benchmark-run probe --target-host HOST --target-port PORT [--probes N] [--timeout-ms MS]
    oci-benchmark-run reduce RESULTS... [--output FORMAT]
    oci-benchmark-run fixture --scenario NAME
    oci-benchmark-run schema-validate FILE
    oci-benchmark-run self-test

No hardcoded endpoints. All targets are operator-supplied.
No credentials or API keys are ever read, written, or transmitted.
"""

import argparse
import json
import math
import os
import re
import socket
import ssl
import statistics
import sys
import time
from datetime import datetime, timezone
from typing import Optional


# ── constants ────────────────────────────────────────────────────────────────

VERSION = "1.0.0"
BENCHMARK_ID_PREFIX = "oci-region-bench"

# Patterns that indicate secrets
SECRET_PATTERNS = [
    re.compile(r"(?i)\b(api[_-]?key|token|secret|password|credential|bearer|access[_-]?key|private[_-]?key)\b"),
    re.compile(r"[^\s:]+:[^\s@]+@"),  # user:password@host
    re.compile(r"://[^\s@]+@"),  # protocol://user:pass@host
    re.compile(r"(?i)(sk-[a-zA-Z0-9]{20,})"),  # OpenAI-style keys
    re.compile(r"(?i)(eyJ[a-zA-Z0-9_-]{10,}\.[a-zA-Z0-9_-]{8,}\.[a-zA-Z0-9_-]{5,})"),  # JWT (sig min 5)
]

# ── redaction ────────────────────────────────────────────────────────────────

def redact(text: str) -> str:
    """Replace anything that looks like a secret with [REDACTED]."""
    for pattern in SECRET_PATTERNS:
        text = pattern.sub("[REDACTED]", text)
    return text


def check_no_secrets(data) -> list[str]:
    """Recursively scan a structure for secret-bearing strings. Returns list of violations."""
    violations = []
    if isinstance(data, str):
        for pattern in SECRET_PATTERNS:
            if pattern.search(data):
                violations.append(f"Secret pattern '{pattern.pattern}' found in: {data[:100]}")
    elif isinstance(data, dict):
        for k, v in data.items():
            violations.extend(check_no_secrets(k))
            violations.extend(check_no_secrets(v))
    elif isinstance(data, list):
        for item in data:
            violations.extend(check_no_secrets(item))
    return violations


# ── latency probe ────────────────────────────────────────────────────────────

class ProbeResult:
    def __init__(self):
        self.dns_latency_ms: Optional[float] = None
        self.tcp_latency_ms: Optional[float] = None
        self.tls_latency_ms: Optional[float] = None
        self.http_latency_ms: Optional[float] = None
        self.error: Optional[str] = None
        self.timed_out: bool = False


def resolve_host(host: str) -> tuple[str, float]:
    """Resolve hostname. Returns (ip, latency_ms)."""
    t0 = time.perf_counter()
    ip = socket.getaddrinfo(host, None, socket.AF_INET, socket.SOCK_STREAM)[0][4][0]
    return ip, (time.perf_counter() - t0) * 1000


def tcp_connect(host: str, port: int, timeout_s: float) -> tuple[socket.socket, float]:
    """TCP connect. Returns (socket, latency_ms)."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(timeout_s)
    t0 = time.perf_counter()
    sock.connect((host, port))
    return sock, (time.perf_counter() - t0) * 1000


def tls_handshake(sock: socket.socket, host: str, timeout_s: float) -> tuple[ssl.SSLSocket, float]:
    """TLS handshake. Returns (ssl_socket, latency_ms)."""
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    t0 = time.perf_counter()
    ssock = ctx.wrap_socket(sock, server_hostname=host)
    return ssock, (time.perf_counter() - t0) * 1000


def http_request(ssock, host: str, timeout_s: float) -> float:
    """HTTP GET /. Returns latency_ms."""
    request = f"GET / HTTP/1.1\r\nHost: {host}\r\nConnection: close\r\n\r\n"
    t0 = time.perf_counter()
    ssock.sendall(request.encode())
    ssock.recv(4096)
    return (time.perf_counter() - t0) * 1000


def probe_target(host: str, port: int = 443, timeout_ms: int = 5000) -> ProbeResult:
    """Run a full DNS→TCP→TLS→HTTP probe. Returns structured result."""
    result = ProbeResult()
    timeout_s = timeout_ms / 1000.0

    try:
        ip, result.dns_latency_ms = resolve_host(host)
    except Exception as e:
        result.error = f"DNS resolution failed: {e}"
        result.timed_out = "timeout" in str(e).lower() or "timed out" in str(e).lower()
        return result

    sock = None
    ssock = None
    try:
        sock, result.tcp_latency_ms = tcp_connect(host, port, timeout_s)
    except Exception as e:
        result.error = f"TCP connect failed: {e}"
        result.timed_out = "timeout" in str(e).lower() or "timed out" in str(e).lower()
        return result

    try:
        ssock, result.tls_latency_ms = tls_handshake(sock, host, timeout_s)
    except Exception as e:
        result.error = f"TLS handshake failed: {e}"
        result.timed_out = "timeout" in str(e).lower() or "timed out" in str(e).lower()
        try:
            sock.close()
        except Exception:
            pass
        return result

    try:
        result.http_latency_ms = http_request(ssock, host, timeout_s)
    except Exception as e:
        result.error = f"HTTP request failed: {e}"
        result.timed_out = "timeout" in str(e).lower() or "timed out" in str(e).lower()
    finally:
        try:
            ssock.close()
        except Exception:
            pass

    return result


# ── statistics ───────────────────────────────────────────────────────────────

def compute_stats(values: list[float]) -> dict:
    """Compute p50, p95, p99, mean, min, max, stddev, jitter from sorted values.
    Returns dict with all None if values is empty."""
    if not values:
        return {
            "count": 0, "unit": "ms",
            "min": None, "max": None, "mean": None,
            "p50": None, "p95": None, "p99": None,
            "stddev": None, "jitterMean": None, "jitterMax": None,
        }

    sorted_vals = sorted(values)

    def percentile(data, p):
        k = (len(data) - 1) * p / 100.0
        f = math.floor(k)
        c = math.ceil(k)
        if f == c:
            return data[int(k)]
        return data[f] * (c - k) + data[c] * (k - f)

    jitters = [abs(sorted_vals[i] - sorted_vals[i - 1]) for i in range(1, len(sorted_vals))]

    return {
        "count": len(values),
        "unit": "ms",
        "min": round(sorted_vals[0], 3),
        "max": round(sorted_vals[-1], 3),
        "mean": round(statistics.mean(values), 3),
        "p50": round(percentile(sorted_vals, 50), 3),
        "p95": round(percentile(sorted_vals, 95), 3),
        "p99": round(percentile(sorted_vals, 99), 3),
        "stddev": round(statistics.stdev(values) if len(values) > 1 else 0, 3),
        "jitterMean": round(statistics.mean(jitters) if jitters else 0, 3),
        "jitterMax": round(max(jitters) if jitters else 0, 3),
    }


def reduce_probes(probe_results: list[ProbeResult]) -> dict:
    """Reduce a list of ProbeResults into latency stats per layer."""
    dns_vals = [r.dns_latency_ms for r in probe_results if r.dns_latency_ms is not None]
    tcp_vals = [r.tcp_latency_ms for r in probe_results if r.tcp_latency_ms is not None]
    tls_vals = [r.tls_latency_ms for r in probe_results if r.tls_latency_ms is not None]
    http_vals = [r.http_latency_ms for r in probe_results if r.http_latency_ms is not None]

    failures = sum(1 for r in probe_results if r.error is not None)
    timeouts = sum(1 for r in probe_results if r.timed_out)
    total = len(probe_results)

    return {
        "dns": compute_stats(dns_vals),
        "tcp": compute_stats(tcp_vals),
        "tls": compute_stats(tls_vals),
        "http": compute_stats(http_vals),
        "failureResults": {
            "totalProbes": total,
            "failures": failures,
            "timeouts": timeouts,
            "failureRate": round(failures / total, 4) if total > 0 else 0,
            "lastError": redact(probe_results[-1].error) if probe_results and probe_results[-1].error else None,
        },
    }


# ── synthetic fixtures ────────────────────────────────────────────────────────

FIXTURES = {
    "mumbai-low-latency": {
        "description": "Synthetic Mumbai region with low latency to Supabase (5-20ms DNS, 50-100ms HTTP)",
        "dns_mean": 5, "dns_std": 2,
        "tcp_mean": 30, "tcp_std": 5,
        "tls_mean": 20, "tls_std": 5,
        "http_mean": 70, "http_std": 15,
        "samples": 100,
        "failure_rate": 0.0,
    },
    "hyderabad-moderate-latency": {
        "description": "Synthetic Hyderabad region with moderate latency (8-30ms DNS, 70-150ms HTTP)",
        "dns_mean": 12, "dns_std": 4,
        "tcp_mean": 45, "tcp_std": 8,
        "tls_mean": 30, "tls_std": 8,
        "http_mean": 100, "http_std": 25,
        "samples": 100,
        "failure_rate": 0.01,
    },
    "high-failure": {
        "description": "Synthetic high-failure scenario (50% failure rate)",
        "dns_mean": 10, "dns_std": 3,
        "tcp_mean": 40, "tcp_std": 10,
        "tls_mean": 25, "tls_std": 7,
        "http_mean": 90, "http_std": 20,
        "samples": 100,
        "failure_rate": 0.50,
    },
    "timeout-heavy": {
        "description": "Synthetic scenario with frequent timeouts (30%)",
        "dns_mean": 100, "dns_std": 50,
        "tcp_mean": 200, "tcp_std": 100,
        "tls_mean": 100, "tls_std": 50,
        "http_mean": 500, "http_std": 200,
        "samples": 100,
        "failure_rate": 0.30,
    },
}


def generate_fixture(scenario_name: str) -> list[ProbeResult]:
    """Generate synthetic probe results for testing."""
    import random
    random.seed(42)  # deterministic

    if scenario_name not in FIXTURES:
        print(f"Unknown scenario '{scenario_name}'. Available: {', '.join(FIXTURES)}")
        sys.exit(1)

    cfg = FIXTURES[scenario_name]
    results = []

    for _ in range(cfg["samples"]):
        r = ProbeResult()
        if random.random() >= cfg["failure_rate"]:
            r.dns_latency_ms = max(0.1, random.gauss(cfg["dns_mean"], cfg["dns_std"]))
            r.tcp_latency_ms = max(0.1, random.gauss(cfg["tcp_mean"], cfg["tcp_std"]))
            r.tls_latency_ms = max(0.1, random.gauss(cfg["tls_mean"], cfg["tls_std"]))
            r.http_latency_ms = max(1.0, random.gauss(cfg["http_mean"], cfg["http_std"]))
        else:
            r.error = "Synthetic probe failure"
            r.timed_out = random.random() < 0.6
        results.append(r)

    return results


# ── output formatters ─────────────────────────────────────────────────────────

def format_markdown(results: dict, benchmark_id: str) -> str:
    """Render benchmark results as Markdown."""
    lines = [
        f"# OCI Region Benchmark — {benchmark_id}",
        f"",
        f"**Status:** NOT-YET-MEASURED (synthetic or unreviewed data)",
        f"**Generated:** {datetime.now(timezone.utc).isoformat()}",
        f"",
    ]

    for path in results.get("paths", []):
        lines.append(f"## Path: {path['pathId']} ({path['sourceRegion']} → {path['targetName']})")
        lines.append(f"")
        lines.append(f"| Layer | p50 | p95 | p99 | Mean | Min | Max | StdDev | Jitter (mean/max) |")
        lines.append(f"|-------|-----|-----|-----|------|-----|-----|--------|--------------------|")

        for layer in ["dns", "tcp", "tls", "http"]:
            s = path["latencyResults"].get(layer, {})
            if s.get("count", 0) > 0:
                lines.append(
                    f"| {layer.upper()} | {s['p50']}ms | {s['p95']}ms | {s['p99']}ms | "
                    f"{s['mean']}ms | {s['min']}ms | {s['max']}ms | {s['stddev']}ms | "
                    f"{s['jitterMean']}ms / {s['jitterMax']}ms |"
                )
            else:
                lines.append(f"| {layer.upper()} | — | — | — | — | — | — | — | — |")

        fr = path.get("failureResults", {})
        if fr:
            lines.append(f"")
            lines.append(f"**Failures:** {fr.get('failures', 0)}/{fr.get('totalProbes', 0)} "
                         f"({fr.get('failureRate', 0)*100:.1f}%) — Timeouts: {fr.get('timeouts', 0)}")
            if fr.get("lastError"):
                lines.append(f"**Last error:** `{fr['lastError']}`")

        lines.append(f"")

    # Region comparison placeholder
    lines.append("## Region Comparison")
    lines.append("")
    lines.append("**Result:** NOT-YET-MEASURED")
    lines.append("")
    lines.append("> ⚠️  This report contains **no real measurements**.")
    lines.append("> Real benchmarks require operator-provisioned OCI compute and operator-supplied endpoints.")
    lines.append("> Do not use this data to select a region.")

    return "\n".join(lines)


# ── CLI commands ──────────────────────────────────────────────────────────────

def cmd_probe(args):
    """Run actual network probes against an operator-supplied target."""
    # Secret check on arguments
    for val in [args.target_host, str(args.target_port)]:
        violations = check_no_secrets(val)
        if violations:
            print(f"ERROR: Secret detected in arguments: {violations[0]}", file=sys.stderr)
            sys.exit(1)

    results = []
    for i in range(args.probes):
        if args.interval_ms > 0 and i > 0:
            time.sleep(args.interval_ms / 1000.0)
        r = probe_target(args.target_host, args.target_port, args.timeout_ms)
        results.append(r)

        if args.verbose and (i + 1) % 10 == 0:
            ok = sum(1 for r2 in results if r2.error is None)
            print(f"Probe {i+1}/{args.probes}: {ok} OK, {i+1-ok} errors", file=sys.stderr)

    reduced = reduce_probes(results)
    output = json.dumps(reduced, indent=2)
    print(redact(output))


def cmd_reduce(args):
    """Reduce JSON probe result files into aggregated statistics."""
    all_results = []
    for filepath in args.result_files:
        with open(filepath) as f:
            data = json.load(f)
        # Support both raw probe arrays and already-reduced stats
        if isinstance(data, list):
            for item in data:
                r = ProbeResult()
                r.dns_latency_ms = item.get("dns_latency_ms")
                r.tcp_latency_ms = item.get("tcp_latency_ms")
                r.tls_latency_ms = item.get("tls_latency_ms")
                r.http_latency_ms = item.get("http_latency_ms")
                r.error = item.get("error")
                r.timed_out = item.get("timed_out", False)
                all_results.append(r)
        else:
            # Already reduced — pass through
            print(json.dumps(data, indent=2))
            return

    reduced = reduce_probes(all_results)
    if args.output_format == "json":
        print(json.dumps(reduced, indent=2))
    elif args.output_format == "markdown":
        path_data = {
            "pathId": "combined",
            "sourceRegion": "unknown",
            "targetName": "combined",
            "latencyResults": {k: reduced[k] for k in ["dns", "tcp", "tls", "http"]},
        }
        if "failureResults" in reduced:
            path_data["failureResults"] = reduced["failureResults"]
        doc = {"paths": [path_data]}
        print(format_markdown(doc, "reduce-combined"))


def cmd_fixture(args):
    """Generate synthetic probe data for testing."""
    results = generate_fixture(args.scenario)
    reduced = reduce_probes(results)

    if args.output_format == "json":
        print(json.dumps(reduced, indent=2))
    elif args.output_format == "markdown":
        path_data = {
            "pathId": f"synth-{args.scenario}",
            "sourceRegion": "synthetic",
            "targetName": f"fixture-{args.scenario}",
            "latencyResults": {k: reduced[k] for k in ["dns", "tcp", "tls", "http"]},
        }
        if "failureResults" in reduced:
            path_data["failureResults"] = reduced["failureResults"]
        doc = {"paths": [path_data]}
        print(format_markdown(doc, f"fixture-{args.scenario}"))


def cmd_schema_validate(args):
    """Validate a benchmark result JSON against the schema."""
    schema_path = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "..", "infra", "benchmarks", "oci", "benchmark-result-schema.json"
    )
    try:
        import jsonschema
    except ImportError:
        print("WARNING: jsonschema not installed. Performing basic structural checks only.", file=sys.stderr)
        with open(args.file) as f:
            data = json.load(f)
        # Basic checks
        violations = check_no_secrets(data)
        if violations:
            print(f"FAIL: Secret(s) detected: {violations}", file=sys.stderr)
            sys.exit(1)
        required = ["schemaVersion", "benchmarkId", "timestamp", "regions", "paths", "computeAvailability", "summary"]
        missing = [k for k in required if k not in data]
        if missing:
            print(f"FAIL: Missing required fields: {missing}", file=sys.stderr)
            sys.exit(1)
        print("PASS (basic checks): no secrets, required fields present")
        return

    with open(schema_path) as f:
        schema = json.load(f)
    with open(args.file) as f:
        data = json.load(f)

    try:
        jsonschema.validate(data, schema)
        print("PASS: Document validates against schema")
    except jsonschema.ValidationError as e:
        print(f"FAIL: {e.message}", file=sys.stderr)
        sys.exit(1)


