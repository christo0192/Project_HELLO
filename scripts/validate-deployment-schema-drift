#!/usr/bin/env node
"use strict";

/**
 * validate-deployment-schema-drift — contract-critical schema drift validation
 * for every published Phase 11 (PR-B) schema.
 *
 * HONESTY BOUNDARY: the repository does not vendor a full JSON Schema engine
 * (no new dependencies are permitted), so this validator does NOT claim full
 * Draft 2020-12 validation. CI verifies CONTRACT-CRITICAL SCHEMA DRIFT only:
 * it freezes the machine-critical invariants of each published schema —
 * required keys, const values, enums, patterns, minima, and
 * additionalProperties:false — and fails whenever a schema file drifts away
 * from its frozen contract. Representative positive and negative fixtures are
 * run through the same frozen contract, and the executable validators
 * (validate-deployment-contracts, validate-deployment-release,
 * artifact-provenance-validate, capacity-benchmark-run) are probed to confirm
 * they AGREE with the schema-critical invariants.
 *
 * Schemas covered (all Phase 11 published machine contracts):
 *   config/deployment-capacity-contracts.schema.json
 *   config/deployment-capacity-parity.schema.json
 *   config/deployment-capacity-release.schema.json
 *   config/deployment-capacity-provenance.schema.json
 *   config/deployment-capacity-ha.schema.json
 *   infra/capacity/benchmark.schema.json
 *   infra/capacity/benchmark-report.schema.json
 *   infra/capacity/managed-topology.schema.json
 *
 * Usage:
 *   node scripts/validate-deployment-schema-drift
 * Exit 0 = every frozen invariant holds and executable validators agree.
 * Exit 1 = schema drift or validator disagreement detected.
 */

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

const ROOT = path.resolve(__dirname, "..");
const failures = [];
let checksRun = 0;

function check(name, condition, detail) {
  checksRun += 1;
  if (!condition) failures.push(`${name}${detail ? ` (${detail})` : ""}`);
}

function getByPath(obj, dotted) {
  return dotted.split(".").reduce((acc, key) => (acc === undefined || acc === null ? undefined : acc[key]), obj);
}

function deepEqual(a, b) {
  if (a === b) return true;
  if (Array.isArray(a) && Array.isArray(b)) {
    return a.length === b.length && a.every((item, i) => deepEqual(item, b[i]));
  }
  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
    const ka = Object.keys(a);
    const kb = Object.keys(b);
    return ka.length === kb.length && ka.every((k) => deepEqual(a[k], b[k]));
  }
  return false;
}

/**
 * Split a schema path such as "properties.policy.properties.capacityApproved.const"
 * into { schemaTokens, keyword, dataPath }.
 */
function parseSchemaPath(schemaPath) {
  const tokens = schemaPath.split(".");
  const keyword = tokens[tokens.length - 1];
  const schemaTokens = tokens.slice(0, -1);
  const dataPath = schemaTokens
    .filter((t) => t !== "properties" && t !== "items" && t !== "$defs")
    .join(".");
  return { schemaTokens, keyword, dataPath };
}

/**
 * Schema-invariant entry: { path: "<schema dotted path ending in keyword>", value }.
 * Checks BOTH the schema declaration (schema[path] === value) and the data
 * contract (doc[dataPath] satisfies the keyword constraint).
 */
function checkInvariant(schema, entry) {
  const { schemaTokens, keyword, dataPath } = parseSchemaPath(entry.path);
  const parent = getByPath(schema, schemaTokens.join("."));
  const schemaValue = parent === undefined || parent === null ? undefined : parent[keyword];
  if (schemaValue === undefined) {
    check(`schema ${schema.$id ?? entry.path}: missing node ${entry.path}`, false, "schema node missing");
    return;
  }
  check(`schema ${schema.$id ?? entry.path}: ${entry.path} === ${JSON.stringify(entry.value)}`, deepEqual(schemaValue, entry.value),
    `schema declares ${JSON.stringify(schemaValue)}`);
  entry.positiveChecks.forEach(({ doc, label }) => {
    const dataNode = getByPath(doc, dataPath);
    if (dataNode === undefined) return; // optional field absent — not a violation
    let ok;
    switch (keyword) {
      case "const":
        ok = dataNode === entry.value;
        break;
      case "enum":
        ok = Array.isArray(entry.value) && entry.value.includes(dataNode);
        break;
      case "pattern":
        ok = typeof dataNode === "string" && new RegExp(entry.value).test(dataNode);
        break;
      case "minimum":
        // Nullable numeric fields (e.g. canary.observationWindowMinutes) allow
        // null as "not yet set"; minimum applies to numeric values only.
        ok = dataNode === null || (typeof dataNode === "number" && dataNode >= entry.value);
        break;
      case "maxItems":
        ok = Array.isArray(dataNode) && dataNode.length <= entry.value;
        break;
      default:
        ok = true;
    }
    check(`data fixture "${label}" ${dataPath} satisfies ${keyword} ${JSON.stringify(entry.value)}`, ok,
      `got ${JSON.stringify(dataNode)}`);
  });
  entry.negativeChecks.forEach(({ doc, label }) => {
    const dataNode = getByPath(doc, dataPath);
    if (dataNode === undefined) return;
    let ok;
    switch (keyword) {
      case "const":
        ok = dataNode !== entry.value;
        break;
      case "enum":
        ok = !(Array.isArray(entry.value) && entry.value.includes(dataNode));
        break;
      case "pattern":
        ok = typeof dataNode !== "string" || !new RegExp(entry.value).test(dataNode);
        break;
      case "minimum":
        ok = typeof dataNode !== "number" || dataNode < entry.value;
        break;
      case "maxItems":
        ok = !Array.isArray(dataNode) || dataNode.length > entry.value;
        break;
      default:
        ok = true;
    }
    check(`data fixture "${label}" ${dataPath} violates ${keyword} ${JSON.stringify(entry.value)}`, ok,
      `got ${JSON.stringify(dataNode)}`);
  });
}

/**
 * additionalProperties:false check. entries are DATA paths ("$" = root).
 * For each, the schema object node must declare additionalProperties:false
 * and the data object must use only declared property names.
 */
function checkAdditionalProperties(schema, entry) {
  const dataPath = entry.path; // data path like "$", "policy", "secretModel"
  const schemaTokens = dataPath === "$" ? [] : dataPath.split(".").map((seg) => `properties.${seg}`).join(".").split(".");
  const schemaNode = dataPath === "$" ? schema : getByPath(schema, schemaTokens.join("."));
  if (schemaNode === undefined || typeof schemaNode !== "object") {
    check(`schema ${schema.$id ?? entry.path}: additionalProperties node for ${dataPath}`, false, "schema node missing");
    return;
  }
  check(`schema ${schema.$id ?? entry.path}: additionalProperties:false at ${dataPath === "$" ? "$" : dataPath}`,
    schemaNode.additionalProperties === false,
    `schema declares ${JSON.stringify(schemaNode.additionalProperties)}`);
  const declared = new Set(Object.keys(schemaNode.properties ?? {}));
  entry.dataChecks.forEach(({ doc, label }) => {
    const dataNode = dataPath === "$" ? doc : getByPath(doc, dataPath);
    if (dataNode === undefined || typeof dataNode !== "object" || Array.isArray(dataNode)) return;
    const extra = Object.keys(dataNode).filter((k) => !declared.has(k));
    check(`data fixture "${label}" ${dataPath}: no undeclared keys`, extra.length === 0,
      `undeclared: ${extra.join(", ")}`);
  });
}

