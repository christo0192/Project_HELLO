    negative: fixtureSet("report-negative", negReport),
  },
  {
    file: "infra/capacity/managed-topology.schema.json",
    requiredTop: ["manifestVersion", "title", "description", "adrReference", "status", "approvalStatus", "provisioned", "deployed", "components", "externalPending"],
    invariants: [
      { path: "properties.provisioned.const", value: false },
      { path: "properties.deployed.const", value: false, neg: { doc: negTopology, label: "topology-negative" } },
      { path: "properties.approvalStatus.const", value: "PENDING" },
      { path: "properties.status.enum", value: ["PROPOSED", "PENDING"] },
      { path: "properties.components.items.properties.scaleTriggers.items.properties.status.enum", value: ["PROPOSED", "PENDING"] },
    ],
    additionalProps: [{ path: "$" }],
    positive: fixtureSet("topology", shippedTopology),
    negative: fixtureSet("topology-negative", negTopology),
  },
];

function readJson(filePath) {
  try {
    return JSON.parse(fs.readFileSync(path.join(ROOT, filePath), "utf8"));
  } catch (e) {
    throw new Error(`cannot read ${filePath}: ${e.message}`);
  }
}

// ── Run schema contract checks ──────────────────────────────────────────

for (const schemaDef of SCHEMAS) {
  let schema;
  try {
    schema = readJson(schemaDef.file);
  } catch (e) {
    failures.push(e.message);
    continue;
  }
  const id = schemaDef.file;

  for (const key of schemaDef.requiredTop) {
    check(`schema ${id}: required contains ${key}`, Array.isArray(schema.required) && schema.required.includes(key),
      `required=${JSON.stringify(schema.required)}`);
  }
  for (const inv of schemaDef.invariants) {
    checkInvariant(schema, {
      ...inv,
      positiveChecks: schemaDef.positive,
      negativeChecks: inv.neg ? [inv.neg] : [],
    });
  }
  for (const addProp of schemaDef.additionalProps) {
    checkAdditionalProperties(schema, { ...addProp, dataChecks: schemaDef.positive });
  }
}

// ── Executable-validator agreement probes (offline) ─────────────────────

function runNode(script, args, label) {
  const result = spawnSync(process.execPath, [script, ...args], { cwd: ROOT, encoding: "utf8" });
  check(`executable agreement: ${label} exit 0`, result.status === 0,
    `exit=${result.status} ${(result.stderr || "").slice(0, 200)}`);
  return result;
}

function runNodeExpectFail(script, args, label) {
  const result = spawnSync(process.execPath, [script, ...args], { cwd: ROOT, encoding: "utf8" });
  check(`executable agreement: ${label} rejects (exit non-zero)`, result.status !== 0,
    `expected rejection but exit=0`);
  return result;
}

// Positive agreement: shipped data satisfies both schema contract and the executable validator.
runNode("scripts/validate-deployment-contracts", [], "validate-deployment-contracts repo mode");
runNode("scripts/validate-deployment-contracts", ["--fixtures"], "validate-deployment-contracts --fixtures");
runNode("scripts/validate-deployment-release", ["validate", "infra/deployment-contracts/release-record.example.json"], "validate-deployment-release example record");
runNode("scripts/validate-deployment-release", ["--fixtures"], "validate-deployment-release --fixtures");
runNode("scripts/artifact-provenance-validate", ["validate", "infra/deployment-contracts/provenance-manifest.json"], "artifact-provenance-validate repo template");
runNode("scripts/artifact-provenance-validate", ["--fixtures"], "artifact-provenance-validate --fixtures");
runNode("scripts/capacity-benchmark-run", ["ha-validate", "infra/capacity/ha-decision.example.json"], "capacity ha-validate example");
runNode("scripts/capacity-benchmark-run", ["topology-validate", "infra/capacity/managed-topology.manifest.json"], "capacity topology-validate manifest");

// Negative agreement: schema-contract negatives must also be rejected by the
// executable validators that accept a file argument (temp files, offline).
const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "dep-schema-drift-"));
try {
  const writeNeg = (name, doc) => {
    const p = path.join(tempDir, name);
    fs.writeFileSync(p, JSON.stringify(doc));
    return p;
  };
  runNodeExpectFail("scripts/validate-deployment-release", ["validate", writeNeg("release-neg.json", negRelease)], "release validator rejects ACCEPTED approval");
  runNodeExpectFail("scripts/artifact-provenance-validate", ["validate", writeNeg("prov-neg.json", negProvenance)], "provenance validator rejects signed:true");
  runNodeExpectFail("scripts/capacity-benchmark-run", ["ha-validate", writeNeg("ha-neg.json", negHa)], "capacity ha-validate rejects ACCEPTED");
  runNodeExpectFail("scripts/capacity-benchmark-run", ["topology-validate", writeNeg("topo-neg.json", negTopology)], "capacity topology-validate rejects deployed:true");
  runNodeExpectFail("scripts/capacity-benchmark-run", ["config-validate", writeNeg("bench-neg.json", negBenchmark)], "capacity config-validate rejects non-synthetic scenario");
  runNodeExpectFail("scripts/capacity-benchmark-run", ["schema-validate", writeNeg("report-neg.json", negReport)], "capacity schema-validate rejects capacityApproved:true");
} finally {
  fs.rmSync(tempDir, { recursive: true, force: true });
}

// ── Report ──────────────────────────────────────────────────────────────

if (failures.length) {
  console.error(`validate-deployment-schema-drift FAILED (${failures.length}):`);
  for (const f of failures) console.error(`- ${f}`);
  process.exit(1);
}
console.log(`validate-deployment-schema-drift passed: ${SCHEMAS.length} published Phase 11 schemas, ${checksRun} contract-critical invariant checks, all executable validators agree.`);
console.log("NOTE: this is contract-critical schema drift validation, not full Draft 2020-12 validation (no JSON Schema engine dependency is permitted).");
