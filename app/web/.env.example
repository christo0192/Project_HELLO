VITE_API_BASE=http://localhost:8787
VITE_SUPABASE_URL=replace_me
VITE_SUPABASE_ANON_KEY=replace_me
VITE_LIVEKIT_URL=replace_me
# Optional comma-separated Supabase OAuth providers (google,github,azure,keycloak).
# Provider secrets stay in Supabase/provider configuration, never the browser.
VITE_SSO_PROVIDERS=
# CSP mode (REQUIRED for production): report-only or enforce
VITE_CSP_MODE=report-only
# CSP violation report endpoint (REQUIRED for production)
VITE_CSP_REPORT_ENDPOINT=http://localhost:8787/api/csp-report
# OPTIONAL. The R1 recordings store's https origin (https://<account>.r2.cloudflarestorage.com,
# with .eu. or .fedramp. before r2 for a jurisdiction bucket; a comma list is allowed). Added to the
# dev/preview CSP media-src ONLY, so a presigned recording link plays without a report. Leave empty
# until the bucket exists; empty leaves the policy unchanged.
VITE_R1_RECORDINGS_ORIGIN=
# Candidate invite experience. Set false to restore the legacy join CTA during rollback.
VITE_CANDIDATE_WEBRTC_V2=true
