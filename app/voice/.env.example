# ── Anthropic (live-call brain; Haiku streams tokens into TTS) ───────────────
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Sarvam (STT + TTS, single Indian vendor) ────────────────────────────────
SARVAM_API_KEY=replace_me
SARVAM_TTS_VOICE=anushka        # anushka/manisha/vidya/arya (v2) · aditya/shubh (v3)
SARVAM_TTS_MODEL=bulbul:v2      # v2 (₹15/10k, stable) · v3 (₹30/10k). If 402 -> top up credits or try v3.
SARVAM_STT_MODEL=saaras:v3
SARVAM_LANGUAGE=en-IN
TTS_SAMPLE_RATE=8000            # telephony narrowband
STT_SAMPLE_RATE=16000

# Turn-taking patience (raise to avoid cutting off a candidate who is thinking)
VAD_STOP_SECS=1.0              # silence before VAD says they stopped
SMART_TURN_STOP_SECS=5.0      # max silence before forcing turn end
MAX_CALL_SECS=600             # hard cap on call length

COMPANY_NAME=Example Company

# ── Supabase persistence — DIRECT POSTGRES (asyncpg) ────────────────────────
# Settings → Database → Connection string → URI (pooler, port 5432, with password).
# Bypasses PostgREST so the schema-cache PGRST204 error can never recur.
SUPABASE_DB_URL=replace_me
SUPABASE_SCHEMA=screening_v2

# Call-recording upload to Supabase Storage (REST; needs service_role key).
SUPABASE_URL=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
RECORDINGS_BUCKET=recordings_v2
