# ── Supabase ────────────────────────────────────────────────────────
# Development project URL. Never use a staging or production identifier here.
SUPABASE_URL=replace_me
# service_role key — SERVER ONLY. Never ship to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=replace_me
# Postgres schema holding the v2 tables (NOT public).
SUPABASE_SCHEMA=screening_v2

# ── LLM brain (DeepSeek HTTP provider) ──────────────────────────────
# Server-side only. Never ship provider API keys to the browser.
DEEPSEEK_API_KEY=replace_me
# DeepSeek V4 Flash-compatible chat model alias. Adjust to the exact account
# model identifier when provisioned by the provider/gateway.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SCORING_MODEL=deepseek-chat
# Optional OpenAI-compatible endpoint override for a gateway/proxy.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_OUTPUT_BYTES=5242880
# Legacy Claude CLI knobs are retained only for compatibility/fallback tests;
# active production API inference uses DeepSeek.
CLAUDE_MODEL=haiku
CLAUDE_SCORING_MODEL=sonnet
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_MS=120000
# Company name injected into the mandatory AI-disclosure opening line.
COMPANY_NAME=Example Company

# ── Server ──────────────────────────────────────────────────────────
PORT=8787
# CORS origin for the frontend dev server.
WEB_ORIGIN=http://localhost:5173

# LiveKit browser screening
LIVEKIT_URL=replace_me
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Supabase Storage bucket for browser call playback uploads.
RECORDINGS_BUCKET=recordings_v2

# MIG-06: TTL (seconds) for recruiter recording download signed URLs (60-900, default 300).
RECORDING_DOWNLOAD_TTL_SEC=300

# REC-03 (PROPOSED): reduced bounded browser audio-upload cap in bytes
# (1024-52428800; default 25 MiB; hard max 50 MiB — strictly below the old
# 100 MB cap). Oversize is rejected by multer as 413 BEFORE buffering.
RECORDING_MAX_BYTES=26214400

# Authoritative LiveKit room-composite recording. Enable only after creating
# dedicated Supabase Storage S3 access credentials. Required mode fails closed:
# no screening room is opened unless server-side recording starts successfully.
RECORDING_EGRESS_ENABLED=false
RECORDING_EGRESS_REQUIRED=false
RECORDING_EGRESS_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
RECORDING_EGRESS_S3_REGION=ap-south-1
RECORDING_EGRESS_S3_ACCESS_KEY_ID=replace_me
RECORDING_EGRESS_S3_SECRET_ACCESS_KEY=replace_me
RECORDING_EGRESS_FINALIZE_TIMEOUT_MS=20000

# Runtime environment (development | production). Sets security header behaviour.
NODE_ENV=development

# ── REL-08 graceful shutdown ─────────────────────────────────────────
# Grace period (ms) before in-flight connections are force-destroyed on SIGTERM.
SHUTDOWN_GRACE_MS=30000

# ── Provider resilience (REL-05) ───────────────────────────────────
# Circuit breaker: max consecutive provider failures before opening.
BREAKER_FAILURE_THRESHOLD=5
# Cooldown (ms) in OPEN state before allowing one half-open probe.
BREAKER_COOLDOWN_MS=30000
# Per-call timeout (ms) for provider calls. 0 = no separate timeout.
BREAKER_TIMEOUT_MS=60000
# Max bytes collected from claude CLI stdout/stderr (5 MiB default).
CLAUDE_MAX_OUTPUT_BYTES=5242880

# ── Rate limiting (SEC-04) ──────────────────────────────────────────
# Default rate limit: requests per 60s window per user.
RATE_LIMIT_DEFAULT=100
# Strict rate limit for screening/assess/upload endpoints.
RATE_LIMIT_STRICT=20
# Global requests per IP before authentication.
RATE_LIMIT_IP=300
# Rate limit window in seconds.
RATE_LIMIT_WINDOW_SEC=60

# Worker-only context bearer credential (minimum 32 characters).
# Keep empty in source; inject through the approved secret mechanism.
WORKER_CONTEXT_SECRET=replace_me

# Resume ingestion. `test` is development-only. For production, install ClamAV
# and set RESUME_SCANNER=clamav (optionally RESUME_SCANNER_BIN=/usr/bin/clamscan).
# Unknown or missing production scanner settings fail closed.
RESUME_SCANNER=test
RESUME_SCANNER_BIN=clamscan
RESUME_SCANNER_TIMEOUT_MS=120000
# ClamAV signature freshness. A stale `clamscan` still exits 0 on a clean file,
# so the scanner proves the signature database is present, parseable and within
# this ceiling BEFORE it runs the binary, and rejects the file otherwise.
# Bounded to 1..168 hours; a malformed value falls back to 24.
RESUME_SCANNER_DB_DIR=/var/lib/clamav
RESUME_SCANNER_MAX_DB_AGE_HOURS=24
# Signature updater, run by the container supervisor when RESUME_SCANNER=clamav.
# No database is baked into the image; these own the refresh lifecycle.
# Interval bounded to 15min..12h, timeout to 60s..30min.
AV_UPDATER_INTERVAL_MS=3600000
AV_UPDATER_TIMEOUT_MS=600000
RESUME_MAX_COMPRESSED_BYTES=10485760
RESUME_PARSER_TIMEOUT_MS=30000
RESUME_MAX_TEXT_LENGTH=50000

# ── Trusted proxy (SEC-04) ──────────────────────────────────────────
# Comma-separated list of trusted proxy CIDRs or 'loopback'.
# Empty = no proxy trust (default). Set when behind a known reverse proxy.
TRUSTED_PROXY=

# ── Ashby integration (Wave 2) ──────────────────────────────────────
# Master switch for the Ashby webhook + reconciliation integration. DISABLED
# by default: the webhook route fails closed (503) and no outbound Ashby call
# is ever made unless this is "true" AND ASHBY_WEBHOOK_SECRET is provisioned.
ASHBY_INTEGRATION_ENABLED=false
# Per-webhook HMAC-SHA256 shared secret from the Ashby webhook settings, used
# only to verify the Ashby-Signature over the raw request bytes. Keep empty in
# source; inject through the approved secret mechanism (never commit a value).
ASHBY_WEBHOOK_SECRET=replace_me

# ── Ashby runtime activation (workers + scheduler + outbound client) ────────
# SECOND, INDEPENDENT switch on top of ASHBY_INTEGRATION_ENABLED. The runtime
# only starts when BOTH flags are true AND ASHBY_API_KEY is provisioned. With
# the defaults below nothing is constructed: no client, no timer, no DB poll,
# no network call.
ASHBY_RUNTIME_ENABLED=false
# Ashby API key, used as the HTTP Basic username against the fixed allowlisted
# origin. Keep empty in source; inject through the approved secret mechanism
# (fly secrets set) — never commit a value and never paste one into chat.
ASHBY_API_KEY=replace_me
# Comma-separated EXACT hostnames permitted for presigned resume downloads.
# EMPTY BY DEFAULT, which keeps the SSRF allowlist disabled and every resume
# fetch fail-closed. No wildcards and no suffix matching: each entry must be a
# complete hostname, and a malformed entry is dropped rather than widened.
ASHBY_RESUME_HOSTS=
# Bounded scheduler cadences (ms) and the worker lease window (seconds). Every
# value is clamped in code; a malformed value falls back to the default.
ASHBY_SIGNAL_POLL_MS=5000
ASHBY_OPERATION_POLL_MS=5000
ASHBY_RECONCILE_INTERVAL_MS=900000
ASHBY_RECLAIM_INTERVAL_MS=60000
ASHBY_LEASE_SECONDS=60

# Reconciliation sweep tuning (0034 page-anchored continuation). A full sweep
# of a large corpus spans many bounded runs, resuming from a durable page
# anchor; these let a backfill be tuned WITHOUT a deploy. Production measured
# ~119,000 applications paging ~100 at a time regardless of the requested
# limit, i.e. ~24 runs.
#   SWEEP_INTERVAL_MS is the cadence used INSTEAD of RECONCILE_INTERVAL_MS
#   while a sweep is in flight: it keeps the anchor seconds old and turns a
#   day-long backfill into minutes. The single-flight lease makes it safe.
ASHBY_RECONCILE_SWEEP_INTERVAL_MS=10000
ASHBY_RECONCILE_MAX_PAGES=50
ASHBY_RECONCILE_MAX_ITEMS=5000
# A HINT only — the provider returned ~100 per page even when asked for 500.
ASHBY_RECONCILE_PAGE_LIMIT=100
ASHBY_RECONCILE_DEADLINE_MS=60000
# Per-RUN breaker. Page-aligned, so it bounds a pass, not a sweep — and a pass
# fires every few seconds while sweeping. This is a RATE, not the blast radius.
ASHBY_RECONCILE_MAX_ENQUEUE=200
# THE blast-radius bound: absolute jobs one SWEEP may create across all of its
# runs. Exceeding it HALTS reconciliation on the stream until an operator
# forces a resync. Conservative on purpose — the incident this prevents created
# 2,000 jobs. Raise deliberately for a genuinely large first enable.
ASHBY_RECONCILE_SWEEP_MAX_ENQUEUE=2000
# Pages one sweep may consume across runs (~500k applications at ~100/page).
ASHBY_RECONCILE_SWEEP_MAX_PAGES=5000
# Restarts from page 1 before halting — a resume that never holds.
ASHBY_RECONCILE_SWEEP_MAX_RESTARTS=5
# Age at which a persisted page anchor is discarded and the sweep restarts.
ASHBY_RECONCILE_ANCHOR_MAX_AGE_MS=21600000
# Kill switch: skip every anchor read/write (pre-0034 all-or-nothing sweep).
ASHBY_RECONCILE_ANCHOR_DISABLED=false
