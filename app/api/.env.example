# ── Supabase ────────────────────────────────────────────────────────
# Development project URL. Never use a staging or production identifier here.
SUPABASE_URL=replace_me
# service_role key — SERVER ONLY. Never ship to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=replace_me
# Postgres schema holding the v2 tables (NOT public).
SUPABASE_SCHEMA=screening_v2

# ── LLM brain (claude -p CLI) ───────────────────────────────────────
# Model passed to `claude -p --model <MODEL>`. haiku = cheap/fast.
CLAUDE_MODEL=haiku
# Stronger model used only for scoring (accuracy matters; runs once per call).
CLAUDE_SCORING_MODEL=sonnet
# Company name injected into the mandatory AI-disclosure opening line.
COMPANY_NAME=Example Company
# Path to the claude CLI if not on PATH (usually just "claude").
CLAUDE_BIN=claude
# Per-call timeout (ms) for the CLI.
CLAUDE_TIMEOUT_MS=120000

# ── Server ──────────────────────────────────────────────────────────
PORT=8787
# CORS origin for the frontend dev server.
WEB_ORIGIN=http://localhost:5173

# LiveKit browser screening
LIVEKIT_URL=replace_me
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Supabase Storage bucket for browser call playback uploads.
RECORDINGS_BUCKET=recordings_v2

# MIG-06: TTL (seconds) for recruiter recording download signed URLs (60-900, default 300).
RECORDING_DOWNLOAD_TTL_SEC=300

# REC-03 (PROPOSED): reduced bounded browser audio-upload cap in bytes
# (1024-52428800; default 25 MiB; hard max 50 MiB — strictly below the old
# 100 MB cap). Oversize is rejected by multer as 413 BEFORE buffering.
RECORDING_MAX_BYTES=26214400

# Runtime environment (development | production). Sets security header behaviour.
NODE_ENV=development

# ── REL-08 graceful shutdown ─────────────────────────────────────────
# Grace period (ms) before in-flight connections are force-destroyed on SIGTERM.
SHUTDOWN_GRACE_MS=30000

# ── Provider resilience (REL-05) ───────────────────────────────────
# Circuit breaker: max consecutive provider failures before opening.
BREAKER_FAILURE_THRESHOLD=5
# Cooldown (ms) in OPEN state before allowing one half-open probe.
BREAKER_COOLDOWN_MS=30000
# Per-call timeout (ms) for provider calls. 0 = no separate timeout.
BREAKER_TIMEOUT_MS=60000
# Max bytes collected from claude CLI stdout/stderr (5 MiB default).
CLAUDE_MAX_OUTPUT_BYTES=5242880

# ── Rate limiting (SEC-04) ──────────────────────────────────────────
# Default rate limit: requests per 60s window per user.
RATE_LIMIT_DEFAULT=100
# Strict rate limit for screening/assess/upload endpoints.
RATE_LIMIT_STRICT=20
# Global requests per IP before authentication.
RATE_LIMIT_IP=300
# Rate limit window in seconds.
RATE_LIMIT_WINDOW_SEC=60

# Worker-only context bearer credential (minimum 32 characters).
# Keep empty in source; inject through the approved secret mechanism.
WORKER_CONTEXT_SECRET=replace_me

# Resume ingestion. `test` is development-only. For production, install ClamAV
# and set RESUME_SCANNER=clamav (optionally RESUME_SCANNER_BIN=/usr/bin/clamscan).
# Unknown or missing production scanner settings fail closed.
RESUME_SCANNER=test
RESUME_SCANNER_BIN=clamscan
RESUME_SCANNER_TIMEOUT_MS=30000
RESUME_MAX_COMPRESSED_BYTES=10485760
RESUME_PARSER_TIMEOUT_MS=30000
RESUME_MAX_TEXT_LENGTH=50000

# ── Trusted proxy (SEC-04) ──────────────────────────────────────────
# Comma-separated list of trusted proxy CIDRs or 'loopback'.
# Empty = no proxy trust (default). Set when behind a known reverse proxy.
TRUSTED_PROXY=
