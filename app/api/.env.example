# ── Supabase ────────────────────────────────────────────────────────
# Development project URL. Never use a staging or production identifier here.
SUPABASE_URL=replace_me
# service_role key — SERVER ONLY. Never ship to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=replace_me
# Postgres schema holding the v2 tables (NOT public).
SUPABASE_SCHEMA=screening_v2

# ── LLM brain (DeepSeek HTTP provider) ──────────────────────────────
# Server-side only. Never ship provider API keys to the browser.
DEEPSEEK_API_KEY=replace_me
# DeepSeek V4 Flash-compatible chat model alias. Adjust to the exact account
# model identifier when provisioned by the provider/gateway.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SCORING_MODEL=deepseek-chat
# Optional OpenAI-compatible endpoint override for a gateway/proxy.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_OUTPUT_BYTES=5242880
# Legacy Claude CLI knobs are retained only for compatibility/fallback tests;
# active production API inference uses DeepSeek.
CLAUDE_MODEL=haiku
CLAUDE_SCORING_MODEL=sonnet
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_MS=120000
# Company name injected into the mandatory AI-disclosure opening line.
COMPANY_NAME=Example Company

# ── Server ──────────────────────────────────────────────────────────
PORT=8787
# CORS origin for the frontend dev server.
WEB_ORIGIN=http://localhost:5173

# LiveKit browser screening
LIVEKIT_URL=replace_me
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Supabase Storage bucket for browser call playback uploads.
RECORDINGS_BUCKET=recordings_v2

# MIG-06: TTL (seconds) for recruiter recording download signed URLs (60-900, default 300).
RECORDING_DOWNLOAD_TTL_SEC=300

# REC-03 (PROPOSED): reduced bounded browser audio-upload cap in bytes
# (1024-52428800; default 25 MiB; hard max 50 MiB — strictly below the old
# 100 MB cap). Oversize is rejected by multer as 413 BEFORE buffering.
RECORDING_MAX_BYTES=26214400

# PR A: recording producer. 'egress' (default) = LiveKit Cloud room-composite
# egress (Build plan caps concurrent egress at 2). 'worker' = record inside the
# agent worker (RecorderIO mixes candidate+bot audio → MP3 → presigned upload),
# removing the egress-concurrency limit. Any non-'worker' value = egress.
RECORDING_PROVIDER=egress

# Authoritative LiveKit room-composite recording. Enable only after creating
# dedicated Supabase Storage S3 access credentials. Required mode fails closed:
# no screening room is opened unless server-side recording starts successfully.
RECORDING_EGRESS_ENABLED=false
RECORDING_EGRESS_REQUIRED=false
RECORDING_EGRESS_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
RECORDING_EGRESS_S3_REGION=ap-south-1
RECORDING_EGRESS_S3_ACCESS_KEY_ID=replace_me
RECORDING_EGRESS_S3_SECRET_ACCESS_KEY=replace_me
RECORDING_EGRESS_FINALIZE_TIMEOUT_MS=20000

# 0038 — durable recording-finalization convergence. DISABLED by default: the
# migration's terminal-transition trigger records finalization intent durably
# in job_queue whether or not this is on, so enabling it later drains that
# intent rather than rebuilding it. Turn on for ONE machine first, with
# RECORDING_FINALIZE_SWEEP_ADMISSION=5, and watch GET /api/recordings/health.
RECORDING_FINALIZE_WORKER_ENABLED=false
# Seconds a terminal session waits before the sweeper may enqueue it (so the
# sweep does not race the trigger's own 60s grace or the egress's flush).
RECORDING_FINALIZE_GRACE_SEC=60
# Deferral budget PER SESSION before recording_finalize_exhausted_at is
# stamped. Distinct from the queue job's max_attempts, which counts only
# genuine throws — a deferral refunds that one and charges this one.
RECORDING_FINALIZE_MAX_ATTEMPTS=5
# In-flight finalize jobs per machine. The producer/consumer INVARIANT is
# admission <= concurrency * (sweep_ms / poll_ms); at these defaults
# 20 <= 4 * (300000/60000) = 20. Raising admission without raising this is
# clamped at runtime and logged, never silently honoured.
RECORDING_FINALIZE_CONCURRENCY=4
RECORDING_FINALIZE_SWEEP_ADMISSION=20
# How far back a sweep may reach at all (7 days). The first enable runs
# against accumulated history; "everything ever recorded" is not a work list.
RECORDING_FINALIZE_SWEEP_MAX_AGE_SEC=604800
RECORDING_FINALIZE_POLL_MS=60000
RECORDING_FINALIZE_SWEEP_MS=300000
# Reclaim returns expired-lease jobs to pending/DLQ. NOT optional: a machine
# that dies mid-finalize leaves the job `active`, which the dedup index
# covers, so nothing would ever re-enqueue that session again.
# reclaim_expired_jobs is queue-name-agnostic, so this budget is SHARED with
# the Ashby reclaim loop (limit 50) when both runtimes are enabled.
RECORDING_FINALIZE_RECLAIM_MS=60000
RECORDING_FINALIZE_RECLAIM_LIMIT=25
RECORDING_FINALIZE_LEASE_SEC=180
# TTL of the in-process halt-flag cache. The queue runner's admission gate
# consults it on every poll and its contract requires a cheap read; the cost
# is that setting/clearing the halt takes effect within this window.
RECORDING_FINALIZE_HALT_TTL_MS=5000
# Bounded reaper for COMPLETED job_queue rows. The 0038 trigger enqueues one
# job per RECORDED SESSION, and nothing in the repo ever deleted a completed
# job row, so terminal growth is one row per session forever without this.
RECORDING_JOB_REAP_MS=900000
RECORDING_JOB_REAP_AGE_SEC=604800
RECORDING_JOB_REAP_LIMIT=500

# Runtime environment (development | production). Sets security header behaviour.
NODE_ENV=development

# ── REL-08 graceful shutdown ─────────────────────────────────────────
# Grace period (ms) before in-flight connections are force-destroyed on SIGTERM.
SHUTDOWN_GRACE_MS=30000

# ── Provider resilience (REL-05) ───────────────────────────────────
# Circuit breaker: max consecutive provider failures before opening.
BREAKER_FAILURE_THRESHOLD=5
# Cooldown (ms) in OPEN state before allowing one half-open probe.
BREAKER_COOLDOWN_MS=30000
# Per-call timeout (ms) for provider calls. 0 = no separate timeout.
BREAKER_TIMEOUT_MS=60000
# Max bytes collected from claude CLI stdout/stderr (5 MiB default).
CLAUDE_MAX_OUTPUT_BYTES=5242880

# ── Rate limiting (SEC-04) ──────────────────────────────────────────
# Default rate limit: requests per 60s window per user.
RATE_LIMIT_DEFAULT=100
# Strict rate limit for screening/assess/upload endpoints.
RATE_LIMIT_STRICT=20
# Global requests per IP before authentication.
RATE_LIMIT_IP=300
# Rate limit window in seconds.
RATE_LIMIT_WINDOW_SEC=60

# Worker-only context bearer credential (minimum 32 characters).
# Keep empty in source; inject through the approved secret mechanism.
WORKER_CONTEXT_SECRET=replace_me

# Resume ingestion. `test` is development-only. For production, install ClamAV
# and set RESUME_SCANNER=clamav (optionally RESUME_SCANNER_BIN=/usr/bin/clamscan).
# Unknown or missing production scanner settings fail closed.
RESUME_SCANNER=test
RESUME_SCANNER_BIN=clamscan
RESUME_SCANNER_TIMEOUT_MS=120000
# ClamAV signature freshness. A stale `clamscan` still exits 0 on a clean file,
# so the scanner proves the signature database is present, parseable and within
# this ceiling BEFORE it runs the binary, and rejects the file otherwise.
# Bounded to 1..168 hours; a malformed value falls back to 24.
RESUME_SCANNER_DB_DIR=/var/lib/clamav
RESUME_SCANNER_MAX_DB_AGE_HOURS=24
# Signature updater, run by the container supervisor when RESUME_SCANNER=clamav.
# No database is baked into the image; these own the refresh lifecycle.
# Interval bounded to 15min..12h, timeout to 60s..30min.
AV_UPDATER_INTERVAL_MS=3600000
AV_UPDATER_TIMEOUT_MS=600000
RESUME_MAX_COMPRESSED_BYTES=10485760
RESUME_PARSER_TIMEOUT_MS=30000
# Child parser old-space cap (MiB). Clamped to [128, 1024]; production sets 512.
RESUME_PARSER_CHILD_HEAP_MB=256
RESUME_MAX_TEXT_LENGTH=50000

# ── Trusted proxy (SEC-04) ──────────────────────────────────────────
# Comma-separated list of trusted proxy CIDRs or 'loopback'.
# Empty = no proxy trust (default). Set when behind a known reverse proxy.
TRUSTED_PROXY=

# ── Ashby integration (Wave 2) ──────────────────────────────────────
# Master switch for the Ashby webhook + reconciliation integration. DISABLED
# by default: the webhook route fails closed (503) and no outbound Ashby call
# is ever made unless this is "true" AND ASHBY_WEBHOOK_SECRET is provisioned.
ASHBY_INTEGRATION_ENABLED=false
# Per-webhook HMAC-SHA256 shared secret from the Ashby webhook settings, used
# only to verify the Ashby-Signature over the raw request bytes. Keep empty in
# source; inject through the approved secret mechanism (never commit a value).
ASHBY_WEBHOOK_SECRET=replace_me

# ── Ashby runtime activation (workers + scheduler + outbound client) ────────
# SECOND, INDEPENDENT switch on top of ASHBY_INTEGRATION_ENABLED. The runtime
# only starts when BOTH flags are true AND ASHBY_API_KEY is provisioned. With
# the defaults below nothing is constructed: no client, no timer, no DB poll,
# no network call.
ASHBY_RUNTIME_ENABLED=false

# Re-screen scorecard publication is disabled until the tenant contract has
# been verified to permit multiple feedback submissions per application.
ASHBY_RESCREEN_SCORECARD_ENABLED=false
# Ashby API key, used as the HTTP Basic username against the fixed allowlisted
# origin. Keep empty in source; inject through the approved secret mechanism
# (fly secrets set) — never commit a value and never paste one into chat.
ASHBY_API_KEY=replace_me
# Comma-separated EXACT hostnames permitted for presigned resume downloads.
# EMPTY BY DEFAULT, which keeps the SSRF allowlist disabled and every resume
# fetch fail-closed. No wildcards and no suffix matching: each entry must be a
# complete hostname, and a malformed entry is dropped rather than widened.
ASHBY_RESUME_HOSTS=
# Bounded scheduler cadences (ms) and the worker lease window (seconds). Every
# value is clamped in code; a malformed value falls back to the default.
ASHBY_SIGNAL_POLL_MS=5000
ASHBY_OPERATION_POLL_MS=5000
ASHBY_RECONCILE_INTERVAL_MS=900000
ASHBY_RECLAIM_INTERVAL_MS=60000
ASHBY_LEASE_SECONDS=60

# Resume-ingestion scanner gating (0037). Ingestion is held back — never
# failed — while the ClamAV signature database is absent or stale, so a cold
# machine costs cheap polls instead of a candidate's resume. DEFER_SECONDS is
# the wait after a post-claim scanner race; READINESS_TIMEOUT_MS bounds the
# cheap signature-header read on the poll path; DEFER_DEADLINE_MS is the
# wall-clock point at which waiting stops being correct and the ingestion
# fails loudly instead.
ASHBY_SCANNER_DEFER_SECONDS=45
ASHBY_SCANNER_READINESS_TIMEOUT_MS=2000
ASHBY_SCANNER_DEFER_DEADLINE_MS=28800000

# Reconciliation sweep tuning (0034 page-anchored continuation). A full sweep
# of a large corpus spans many bounded runs, resuming from a durable page
# anchor; these let a backfill be tuned WITHOUT a deploy. Production measured
# ~119,000 applications paging ~100 at a time regardless of the requested
# limit, i.e. ~24 runs.
#   SWEEP_INTERVAL_MS is the cadence used INSTEAD of RECONCILE_INTERVAL_MS
#   while a sweep is in flight: it keeps the anchor seconds old and turns a
#   day-long backfill into minutes. The single-flight lease makes it safe.
ASHBY_RECONCILE_SWEEP_INTERVAL_MS=10000
ASHBY_RECONCILE_MAX_PAGES=50
ASHBY_RECONCILE_MAX_ITEMS=5000
# A HINT only — the provider returned ~100 per page even when asked for 500.
ASHBY_RECONCILE_PAGE_LIMIT=100
ASHBY_RECONCILE_DEADLINE_MS=60000
# Per-RUN breaker. Page-aligned, so it bounds a pass, not a sweep — and a pass
# fires every few seconds while sweeping. This is a RATE, not the blast radius.
ASHBY_RECONCILE_MAX_ENQUEUE=200
# THE blast-radius bound: absolute jobs one SWEEP may create across all of its
# runs. Exceeding it HALTS reconciliation on the stream until an operator
# forces a resync. Conservative on purpose — the incident this prevents created
# 2,000 jobs. Raise deliberately for a genuinely large first enable.
ASHBY_RECONCILE_SWEEP_MAX_ENQUEUE=2000
# Pages one sweep may consume across runs (~500k applications at ~100/page).
ASHBY_RECONCILE_SWEEP_MAX_PAGES=5000
# Restarts from page 1 before halting — a resume that never holds.
ASHBY_RECONCILE_SWEEP_MAX_RESTARTS=5
# Age at which a persisted page anchor is discarded and the sweep restarts.
ASHBY_RECONCILE_ANCHOR_MAX_AGE_MS=21600000
# Kill switch: skip every anchor read/write (pre-0034 all-or-nothing sweep).
ASHBY_RECONCILE_ANCHOR_DISABLED=false

# ── Phone screening domain (P2, migration 0042) ─────────────────────
# Master switch for the outbound phone screening domain. DISABLED by default:
# with this false nothing admits, nothing dials, and no timer is armed. The
# durable substrate (0042) additionally refuses every admission in production
# until a validated Indian mobile exists on the candidate row.
PHONE_SCREENING_ENABLED=false
# INDEPENDENT runtime switch, on top of the master flag. Both must be "true"
# before any worker, scheduler or admission attempt exists. Neither implies
# the other — that is the point of the second flag.
PHONE_RUNTIME_ENABLED=false
# off | synthetic | live. "off" (default) places no call at all; "synthetic"
# exercises the path against a local fake; "live" is the only value that could
# reach a carrier, and only once a later phase supplies a transport. An
# unrecognised value reads as "off".
PHONE_DIAL_MODE=off
# Comma-separated SHA-256 hex DIGESTS of the numbers "live" mode may dial —
# never raw numbers, so no phone value ever lives in an environment, a crash
# dump or a log. EMPTY IS FAIL-CLOSED: with no entries nothing is dialable even
# in live mode. Malformed entries are dropped, never coerced.
PHONE_DIAL_ALLOWLIST=
# Bounded tuning values. Every one is CLAMPED in code; a malformed value falls
# back to its default rather than throwing at import.
#   SLOT_SECONDS must stay inside the 900-3600 s appointment envelope 0042's
#   duration CHECK enforces, or a booking would be refused by the trigger.
PHONE_SLOT_SECONDS=1800
#   Reconnect backoff. 120 s is why the calling window is re-evaluated when a
#   reconnect is ACTED ON: a backoff decided at 20:59 lands at 21:01.
PHONE_RECONNECT_BACKOFF_SECONDS=120
PHONE_RING_TIMEOUT_SECONDS=45
#   Concurrency-lease length. admit/heartbeat clamp to [5,900] independently;
#   these bounds stay inside that range so the two never disagree.
#
#   180, NOT 60. The lease has to span the whole stretch during which nobody
#   is heartbeating yet: the ring (PHONE_RING_TIMEOUT_SECONDS, 45 here and up
#   to 120) and THEN the opening gate — classify.human, the spoken disclosure,
#   the candidate's answer, and an awaited LiveKit egress call — which
#   PHONE_OPENING_GATE_SECONDS allows 60 s for. At 60 a candidate answering on
#   the last ring left roughly thirty seconds for that gate, and a gate that
#   overran met an already-lapsed lease: the first heartbeat answered
#   `lease_lost` and the agent hung up seconds after the candidate consented.
#
#   The relation is ENFORCED, not merely suggested — the dial controller
#   refuses with `lease_too_short_for_gate` when
#   PHONE_LEASE_SECONDS < PHONE_RING_TIMEOUT_SECONDS + 60, before it contacts
#   the provider or burns an attempt. A value under that places NO CALLS AT
#   ALL, so this file is kept at a value that satisfies it: copying this file
#   verbatim must produce a lane that dials, not one that refuses everything.
PHONE_LEASE_SECONDS=180
#   Ingress webhook bounds, used by a later phase's route.
PHONE_WEBHOOK_MAX_BYTES=65536
PHONE_WEBHOOK_TOLERANCE_SECONDS=300

# ── Phone safe dialer (P4, migration 0043) ──────────────────────────
# Provider-neutral outbound SIP trunk identifier. OPAQUE to this codebase: it
# is whatever the configured provider calls a trunk, and nothing parses,
# validates against a vendor format, or logs it. EMPTY IS FAIL-CLOSED — with
# no trunk, isLiveDialPermitted() is false and no originate is attempted, even
# in live mode with a populated allowlist. The character class deliberately
# excludes "+" and space so this field can never hold a phone number.
PHONE_SIP_TRUNK_ID=
# Name of the SEPARATE, named phone agent worker. Since the §6 canary flip
# (docs/runbooks/phone-worker-deployment.md) the deploy AUTHORITY is
# app/api/fly.toml [env]; this line only documents that value for local/dev
# copies. The validator (scripts/validate-voice-worker-apps.mjs) checks the
# worker's fly.phone.toml against fly.toml (rejecting a mismatched non-empty
# name in either direction) but does NOT read this file once fly.toml sets the
# key — keep the two in step by hand when renaming. Empty means the phone room
# dispatches NOBODY (the pre-flip posture).
#
# The existing browser worker is deliberately left UNNAMED and auto-dispatching.
# Naming it would stop it auto-dispatching into every existing browser room and
# would silently break browser screening in the window between an API deploy
# and a worker deploy. Rollback for the phone lane is scaling the phone worker
# to zero and reverting the §6 posture PR — no Python change at all.
PHONE_AGENT_NAME=phone-screener
# How long the ORIGINATE CALL ITSELF may block, in seconds. NOT the same knob
# as PHONE_RING_TIMEOUT_SECONDS, which bounds how long the line may ring.
#
# MUST BE STRICTLY GREATER THAN PHONE_RING_TIMEOUT_SECONDS (default 45), and
# the dial controller REFUSES before the SDK if it is not. If the originate
# gives up while the carrier is still ringing, the controller writes the dial
# off as originate_failed — and the leg can still be answered afterwards,
# landing a real person in a room whose dial we have abandoned, on a lease that
# is about to lapse.
#
# Set explicitly because the SDK default is 60 s when waitUntilAnswered is true.
# That is now comfortably inside PHONE_LEASE_SECONDS (180), but it was once
# exactly EQUAL to it — and an originate that blocks for the whole lease races
# reclaim_phone_attempt_leases, which would abandon an attempt whose dial is
# still in flight. Leaving a bound that gates a fleet slot to a provider SDK's
# default is the omission; the number is only the symptom. The dial controller
# additionally refuses to originate unless the lease is proven to outlive this
# value.
PHONE_ORIGINATE_TIMEOUT_SECONDS=60
# Hard ceiling on a CONNECTED call, in seconds. Never left to the provider
# default: an unset billable ceiling is not a default, it is an omission.
PHONE_MAX_CALL_SECONDS=900

# ── Answer-first origination ("bounce" mode) ─────────────────────────────────
# LiveKit Cloud's outbound-SIP state machine never registers the answer on our
# Plivo Zentrunk calls and kills every live call ~45s after INVITE (proven by 8
# live reproductions; server-side, ignores all per-call options). Plivo's own
# answer supervision works. So in bounce mode LiveKit dials a Plivo VOICE-APP
# SIP ENDPOINT that answers INSTANTLY (LiveKit sees an answered call in ~1s, its
# timers are satisfied forever), and Plivo's app then dials the candidate and
# bridges. The candidate number still passes EVERY admission/allowlist gate
# exactly as today; it simply is not what LiveKit dials.
#
# DEFAULT OFF. When off, the dialer's behaviour is byte-identical to the direct
# path and the three fields below are unread. When ON, the two bounce transport
# fields are FAIL-CLOSED: an empty bounce trunk or endpoint user refuses the
# dial (isPhoneTransportReady) rather than dialling down the wrong trunk.
PHONE_BOUNCE_MODE=false
# The LiveKit BOUNCE outbound trunk id — the trunk pointing at Plivo's voice-app
# SIP domain (phone.plivo.com). Provisioned by scripts/phone-bounce-setup.mjs.
# Opaque; the class excludes "+"/space so it can never hold a phone number.
PHONE_BOUNCE_TRUNK_ID=
# The Plivo ENDPOINT USERNAME LiveKit dials in bounce mode (e.g. hello_bounce).
# A bounded opaque identifier — never a phone number.
PHONE_BOUNCE_SIP_USER=
# The caller-id E.164 the candidate sees when Plivo's app dials them. Validated
# as strict +91[6-9]XXXXXXXXX; an invalid value fails closed (the answer route
# hangs up rather than bridging with a bad caller id).
PHONE_BOUNCE_CALLER_ID=

# ── Plivo answer-first webhooks ──────────────────────────────────────────────
# The Plivo auth credentials. In this design they are used ONLY to validate the
# Plivo V3 webhook signature — there are NO Plivo API calls. PLIVO_AUTH_ID is
# carried for console parity only. PLIVO_AUTH_TOKEN must be >=16 chars when
# bounce mode is on; it is the HMAC key for the V3 signature and is NEVER logged.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=replace_me
# The EXACT URLs Plivo signs and calls. They are compared against the V3
# signature, so they must be the URLs configured in the Plivo Application
# verbatim (scheme, host, port, path). Derived from config, never from request
# headers. The answer URL is the SIP endpoint answer callback; the dial-status
# URL is the <Dial> action callback; the hangup URL is the app hangup callback.
PLIVO_ANSWER_URL=
PLIVO_DIAL_STATUS_URL=
PLIVO_HANGUP_URL=

# ── Phone runtime orchestration (P5) ─────────────────────────────────────────
# Cadence and batch bounds for the phone loops. Every value is clamped and none
# is fatal: a malformed value reads as the default, because a runtime that
# refuses to start is a runtime that stops reclaiming leases, and a stuck lease
# holds one of ten fleet slots until a human notices.
#
# NOTHING HERE ARMS ANYTHING. The loops are constructed only when BOTH
# PHONE_SCREENING_ENABLED and PHONE_RUNTIME_ENABLED are true.
# Due sweep cadence, ms (clamped 1000-300000).
PHONE_RUNTIME_DUE_MS=15000
# Attempt-lease reclaim cadence, ms (clamped 5000-600000). Deliberately faster
# than the due sweep is slow: a lapsed lease holds a fleet slot against every
# other candidate, whereas a due engagement that waits a tick has lost nothing.
PHONE_RUNTIME_RECLAIM_MS=30000
# Dropped-webhook reconciliation cadence, ms (clamped 10000-900000).
PHONE_RUNTIME_RECONCILE_MS=60000
# Appointment-expiry cadence, ms (clamped 10000-900000).
PHONE_RUNTIME_EXPIRE_MS=120000
# Engagements offered to admission per due pass (clamped 1-25). Small on
# purpose: each one is a call to a person and the fleet cap is ten.
PHONE_RUNTIME_DUE_LIMIT=3
# Attempt leases reclaimed per pass (clamped 1-200).
PHONE_RUNTIME_RECLAIM_LIMIT=25
# Lease seconds for the phone.dial QUEUE job — not the attempt lease (5-900).
PHONE_RUNTIME_JOB_LEASE_SECONDS=60
# 0072. SHORT reconnect grace, seconds, before a phone session that ended
# non-terminally (candidate hangup / network drop / worker crash) is
# partial-finalized: driven to completed so the MP3 promotes and partial
# scoring is enqueued. Clamped 30-7200; MUST stay far below the 0071 stranded
# 7200s so this wins the race and delivers the scorecard first.
PHONE_PARTIAL_FINALIZE_GRACE_SEC=180

# ── On-demand Fly worker orchestration (PR B) ────────────────────────────────
# Brings a STOPPED worker machine up on demand (start → wait ready) and reaps it
# when idle (stop), so idle Fly cost is ~$0 instead of $32/mo always-on. Nothing
# here arms anything: the Fly Machines client and reaper are constructed only
# when WORKER_ORCHESTRATION=true, and a blank FLY_API_TOKEN fails every Fly call
# closed with code 'auth' (never crashes at import).
# Master gate. false (default) ⇒ the whole orchestration is inert.
WORKER_ORCHESTRATION=false
# App-scoped Fly deploy token (SECRET). Sent as `Authorization: Bearer <token>`.
FLY_API_TOKEN=replace_me
# Fly Machines API base origin. Leave as the default unless testing.
FLY_API_BASE_URL=https://api.fly.io/v1
# Grace seconds a machine may sit `started` with no session before the reaper
# stops it — bounds one window of possible cost leak. Clamped 30-3600.
WORKER_REAPER_GRACE_SEC=180
# Dispatch name of the NAMED browser worker (design §2.3b B-i). EMPTY (default)
# ⇒ the browser worker stays UNNAMED + auto-dispatching and the exchange flow
# performs NO worker gate and NO explicit dispatch — byte-identical to today.
# Set (AND WORKER_ORCHESTRATION=true) to arm ready-before-dispatch: the exchange
# confirms a ready on-demand worker, then explicitly dispatches THIS name into
# the room, then mints the join token. MUST equal the worker's BROWSER_AGENT_NAME
# (names_agree). Naming + dispatch are introduced together behind the same flag.
BROWSER_AGENT_NAME=
