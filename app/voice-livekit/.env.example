# Google AI Studio key — server-side voice worker only.
GEMINI_API_KEY=replace_me
SARVAM_API_KEY=replace_me

COMPANY_NAME=Example Company
GEMINI_MODEL=gemini-3.1-flash-lite
# Phone-only speaker selection. Browser/WebRTC continues using GEMINI_MODEL.
PHONE_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SARVAM_STT_MODEL=saaras:v3
SARVAM_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=simran

LIVEKIT_WORKER_DRAIN_SEC=10
# Candidate inactivity: prompt once, then speak goodbye and close the room.
CANDIDATE_SILENCE_PROMPT_SEC=30
CANDIDATE_SILENCE_END_SEC=20
PHONE_TERMINAL_REPLY_TIMEOUT_SEC=10
# 0038 — bounded room residency. The entrypoint used to await its close event
# with no wall-clock cap, and participant_disconnected never initiates a close,
# so a candidate who closed the tab left the worker resident in the room. On
# timeout the session is persisted with terminal_reason='residency_timeout' —
# its own code, never 'worker_crash'. Clamped to [60, 21600].
SESSION_MAX_RESIDENCY_SEC=3600

# Synthetic local-console demo context only. Production room/participant/token
# metadata must not carry candidate, resume, question, rubric or scoring context.
GOPU_CANDIDATE_NAME=Taylor Example
GOPU_ROLE_TITLE=Customer Success Specialist
GOPU_ROLE_FOCUS=Communication clarity, customer handling, and structured problem solving.
GOPU_RESUME_FACTS=- Name: Taylor Example\n- Current role: Support Associate\n- Total experience: 2 years\n- Skills: communication, customer support\n- Summary: Synthetic local demo profile.
# Or replace the individual values at runtime with synthetic JSON context.
GOPU_CONTEXT_JSON={}

# Only needed for `python agent.py dev` / `start` (connecting to a real LiveKit Cloud room).
# NOT needed for `python agent.py console` (local mic/speaker test).
LIVEKIT_URL=replace_me
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Worker-only persistence. The service-role key must never enter a browser build.
SUPABASE_URL=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_SCHEMA=screening_v2
API_BASE=http://localhost:8787
# Shared worker-only bearer credential; inject at runtime, never commit a value.
WORKER_CONTEXT_SECRET=replace_me
WORKER_CONTEXT_TIMEOUT_SEC=5
# Bounded retry for the worker-context lookup so a transient failure (e.g. an
# API cold start) does not permanently abandon a valid call with no bot.
WORKER_CONTEXT_RESOLVE_ATTEMPTS=3
WORKER_CONTEXT_RESOLVE_BACKOFF_SEC=1.5

# ── Provider resilience (REL-05/REL-06) ───────────────────────────
# Circuit breaker for scoring-trigger HTTP call.
SCORING_BREAKER_THRESHOLD=3
SCORING_BREAKER_COOLDOWN_SEC=30
SCORING_BREAKER_TIMEOUT_SEC=180
# HTTP transport timeouts (seconds).
SCORING_HTTP_CONNECT_TIMEOUT=10
SCORING_HTTP_READ_TIMEOUT=180
SCORING_HTTP_WRITE_TIMEOUT=30
SCORING_HTTP_POOL_TIMEOUT=10

# ── Phone screening worker (P4) ─────────────────────────────────────
# Name this worker registers under. EMPTY (the default) keeps the EXISTING
# unnamed, auto-dispatching browser worker byte-for-byte unchanged; that
# deployment must leave this unset. A SEPARATE phone deployment sets it, which
# makes that worker named — named workers do not auto-dispatch, so it receives
# only the phone rooms the API explicitly dispatches it into. The unnamed
# worker additionally SKIPS phone-marked rooms, so neither marker alone is a
# single point of failure.
PHONE_AGENT_NAME=
# Timeout on a worker->API internal phone event POST, seconds (clamped 1-60).
# Completion may synchronously score the session before returning.
PHONE_EVENT_TIMEOUT_SEC=30
# How long to wait for the SIP participant before giving up, seconds
# (clamped 1-180). The agent does NOT speak, activate or start a silence timer
# until a participant exists: a SIP leg being up says nothing about who, or
# what, answered.
PHONE_PARTICIPANT_WAIT_SEC=45
# Bound on the human-vs-machine classification exchange, seconds (clamped
# 1-120). An unreadable answer fails closed to "machine", which yields no
# recording, no assessment and no scorecard.
PHONE_CLASSIFY_TIMEOUT_SEC=20
# Bound on ONE question's exchange, seconds (clamped 5-300). A bound, not a
# target: without it a candidate who goes quiet mid-answer leaves the leg
# waiting on a queue forever, holding a fleet slot and a live call with no
# boundary to commit and nothing to end it.
PHONE_ANSWER_TIMEOUT_SEC=90

# Per-turn coordination shape. `toolfirst` (DEFAULT, and what any unknown or
# empty value falls back to) is today's behavior byte-for-byte: every
# substantive turn is TWO sequential Gemini legs — a muzzled required-tool pass
# that commits the boundary, then a speech pass. `toolless` is the browser
# lane's ONE-call-per-turn shape: the model authors and speaks the reply in a
# single generation and the SAME idempotent boundary commit fires in the
# BACKGROUND after the reply is delivered. Rollback is instant — set this back
# to `toolfirst` (or unset it) and the tool-first path is restored exactly.
PHONE_TURN_MODE=toolfirst

# Endpointing mode for the PHONE session only. Production uses local Silero VAD
# + v1-mini EOU with locked 0.5 s minimum / 1.5 s maximum endpointing delays.
# `stt`
# delegates end-of-utterance to the STT provider (Sarvam already runs with
# vad_signals=true), moving that decision off the worker's own VAD/EOU compute —
# the load that backed up under CPU starvation on 2026-08-29. The browser
# session never receives this. Rollback is instant — unset it (or set `local`)
# and the byte-path is restored.
PHONE_TURN_DETECTION=local

# Early-flush threshold for the PHONE tts_node (latency knob, PR-2). Sarvam's
# streaming TTS runs an internal sentence tokenizer (min_sentence_len=20,
# min_ctx_len=10), so it does not send the first audio request until a COMPLETE
# ~20-char first sentence exists — the measured ~2.9 s gap between LLM-invoke
# and first audio. The phone lane re-segments the reply and flushes the first
# speakable fragment (first clause / punctuation incl. comma, or once this many
# characters accumulate — whichever first) to Sarvam as soon as it is ready.
# Prosody tradeoff: SMALLER = lower time-to-first-fragment but choppier audio;
# LARGER = smoother but closer to the SDK's sentence-wait latency. Clamped to
# [0, 400]. `0` DISABLES early-flush (per-chunk passthrough → today's behavior)
# and is the instant rollback. PHONE ONLY — the browser lane is never affected.
PHONE_TTS_FLUSH_MIN_CHARS=0

# Patience gate for the PHONE session (X10, live call 23). Default ON. With
# PHONE_TURN_DETECTION=stt, Sarvam delivers a final transcript on every pause,
# so thinking-out-loud fragments ("Hmm", "So the most", "I would say") each
# complete a turn. The gate classifies each candidate final as substantive,
# hesitation, or thinking: it stays SILENT on a hesitation (the fragment stays
# in context and the bot waits for the real answer), gives ONE short
# encouragement on an explicit "let me think", and never advances the question
# plan or stacks a second question on a non-answer. Only the literal `off`
# disables it; empty/unknown/`on` keep it enabled. Rollback is instant — set
# `off` and the pre-X10 behaviour (fragments answered, plan can advance) is
# restored exactly.
PHONE_PATIENCE_GATE=on

# Shadow coverage/conflict judge for the PHONE toolless lane. Default ON. It
# runs in the existing background commit task after a candidate answer: a
# covered owed topic permits the same idempotent boundary commit; not-covered,
# timeout, malformed output, or provider failure leaves the cursor unchanged
# and re-anchors the owed topic on the next turn. Clear resume contradictions
# queue one polite clarification, deduped in-memory per session. No judge call
# is awaited on the candidate-to-reply speech path. Set the literal `off` for
# one-flip rollback to the pre-judge reply-driven commit behavior.
PHONE_COVERAGE_JUDGE=on
# Provider wall clock (seconds) for ONE coverage-judge inference. The selected
# Gemini 3.5 Flash-Lite path benchmarks below this 2.0s deadline. A +0.25s async
# wrapper sits on top. The parser clamps to [1.0, 30.0], and the named phone
# worker refuses to start when the effective production value exceeds 2.0.
PHONE_COVERAGE_TIMEOUT_SEC=2.0
# No live-turn retry: provider failure fails toward re-asking while speech keeps
# moving. Clamped to [0, 3], but production should remain 0.
PHONE_JUDGE_RETRIES=0
# Fixed backoff between judge attempts (seconds). Default 0.15. Clamped [0, 2].
PHONE_JUDGE_RETRY_BACKOFF_SEC=0.15
# Judge circuit-breaker tuning. For a BACKGROUND judge an open breaker silently
# disables coverage+conflict for every turn in the cooldown window, so the
# defaults are softer than the speech path's. Threshold: consecutive provider
# failures before the breaker opens (default 6, clamped [1, 50]). Cooldown:
# open window in seconds during which calls fast-fail to judge_error (default
# 3.0, clamped [0.5, 60.0]).
PHONE_JUDGE_BREAKER_THRESHOLD=6
PHONE_JUDGE_BREAKER_COOLDOWN_SEC=3.0
# INDEPENDENT Gemini judge. The API key is REQUIRED when the judge is on and
# never falls back to GEMINI_API_KEY, isolating interviewer and judge quota/load.
# URL is the full chat/completions endpoint and is posted verbatim.
PHONE_JUDGE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Dedicated model; never inherits GEMINI_MODEL.
PHONE_JUDGE_MODEL=gemini-3.5-flash-lite
# Dedicated owner-provided secret. Never commit or log a real value.
PHONE_JUDGE_API_KEY=replace_me
# Completion-token budget for ONE Gemini judge inference. Default 800 and
# clamped to [64, 2000].
PHONE_JUDGE_MAX_TOKENS=800
# Optional JSON object for provider-specific reasoning controls. Blank defaults
# to {"reasoning_effort":"minimal"}; Gemini 3 models reject `none`.
PHONE_JUDGE_EXTRA_BODY_JSON={"reasoning_effort":"minimal"}
# Authorized generated phone turns must reach first audio within this bound or
# the exact stale SpeechHandle is force-interrupted and drained before one
# candidate-facing, interruptible deterministic fallback is spoken.
PHONE_SPEECH_FIRST_AUDIO_TIMEOUT_SEC=4.0

# ── Canary-1: the owner's own-number test call (PR105) ──────────────
# ALL FOUR are worker-side only. The API is not involved in Canary-1 at all and
# stays silent throughout — `/api/phone/health` reports the domain DISABLED for
# the whole run, which is correct, not a fault.
#
# ARMING IS A FLY APP SECRET, NOT AN [env] KEY. `PHONE_CANARY_ENABLED` must
# never appear in `fly.phone.toml`: `scripts/validate-voice-worker-apps.mjs`
# scans only the `[env]` tables, so a value baked there would be reviewable but
# a lingering SECRET is invisible to CI — which is exactly why the post-run
# disarm is an ops assertion (`fly secrets list`, names only) and not a CI one.
# Default false. Empty, missing or anything but the literal "true" is off.
PHONE_CANARY_ENABLED=false
# Hard ceiling on the canary conversation, seconds (clamped 30-300).
PHONE_CANARY_MAX_CALL_SEC=180
# The canary's OWN wait for "something answered", seconds (clamped 1-180).
# Deliberately NOT the production 45 s: this clock starts at JOB ASSIGNMENT,
# before the originate, so it is charged for dispatch scheduling, a cold worker
# start (num_idle_processes 0, initialize_process_timeout 60 s) AND the whole
# ring window. At 45 it can expire on the HEALTHY path and the failure looks
# like a provider fault. The CLI refuses `waits_misordered` unless this is at
# least `--ring-seconds` + 60.
PHONE_CANARY_PARTICIPANT_WAIT_SEC=120
# How many of the three fixed canary questions to ask (clamped 1-3).
PHONE_CANARY_QUESTIONS=2
PHONE_BOUNCE_MODE=false
